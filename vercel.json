{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/app", "destination": "https://rootmate-app.vercel.app/app" },
    { "source": "/app/:path*", "destination": "https://rootmate-app.vercel.app/app/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
